# ─── App ──────────────────────────────────────────────────────────────────────
APP_NAME="Agente Bolsa"
DEBUG=false
SECRET_KEY="troque-por-uma-chave-aleatoria-longa"

# ─── Banco de Dados ───────────────────────────────────────────────────────────
# SQLite (desenvolvimento):
DATABASE_URL="sqlite+aiosqlite:///./agente_bolsa.db"

# PostgreSQL (produção Railway/Render):
# DATABASE_URL="postgresql+asyncpg://user:senha@host:5432/agente_bolsa"

# ─── Claude API ───────────────────────────────────────────────────────────────
# Obter em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-sonnet-4-6"

# ─── E-mail (Resend) ──────────────────────────────────────────────────────────
# Criar conta e verificar domínio em: https://resend.com
RESEND_API_KEY="re_..."
EMAIL_FROM="bolsa@seudominio.com.br"
EMAIL_TO="voce@email.com"   # múltiplos: "a@email.com,b@email.com"

# ─── Brapi.dev ────────────────────────────────────────────────────────────────
# Gratuito sem token; token em: https://brapi.dev/dashboard
BRAPI_TOKEN=""

# ─── Tavily Search ────────────────────────────────────────────────────────────
# Criar conta em: https://app.tavily.com
TAVILY_API_KEY="tvly-..."

# ─── Reddit API ───────────────────────────────────────────────────────────────
# Criar app em: https://www.reddit.com/prefs/apps  (tipo: script)
REDDIT_CLIENT_ID="..."
REDDIT_CLIENT_SECRET="..."
REDDIT_USER_AGENT="AgenteBolsa/0.1"

# ─── YouTube Data API ─────────────────────────────────────────────────────────
# Google Cloud Console → APIs → YouTube Data API v3
# https://console.cloud.google.com
YOUTUBE_API_KEY="AIza..."

# ─── CVM Fatos Relevantes ─────────────────────────────────────────────────────
# Não requer chave — usa a API pública do EFTS/CVM (efts.cvm.gov.br)
# Fonte ativada automaticamente para todos os tickers.

# ─── Substack Newsletters ─────────────────────────────────────────────────────
# Lista de feeds RSS de newsletters financeiras, separados por vírgula.
# Exemplo: https://investidor.substack.com/feed, https://outra.substack.com/feed
# Deixe vazio para desativar a fonte.
SUBSTACK_FEEDS=""
